structure main
(
    run = λ
    (
        jsvalue cons_1 → a0
        jsvalue neg a0 → r0
        jsvalue cons_1 → one0
        jsvalue add r0 one0 → sum0   ; -1 + 1 == 0
        jsvalue cons_0 → expect0
        jsvalue eq? sum0 expect0 → ok0
        jsvalue assert ok0

        ; neg(neg(neg(1))) == -1
        jsvalue cons_1 → a1
        jsvalue neg a1 → r1
        jsvalue neg r1 → r2
        jsvalue neg r2 → r3
        jsvalue cons_1 → one1
        jsvalue add r3 one1 → sum1   ; -1 + 1 == 0
        jsvalue cons_0 → expect1
        jsvalue eq? sum1 expect1 → ok1
        jsvalue assert ok1
    )
)
