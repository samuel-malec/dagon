structure main
(
    run = λ
    (
        jsvalue cons_3 → a0
        jsvalue cons_3 → b0
        jsvalue eq? a0 b0 → r0        ; 3 == 3
        jsvalue assert r0

        jsvalue cons_3 → a1
        jsvalue cons_4 → b1
        jsvalue ne? a1 b1 → r1        ; 3 != 4
        jsvalue assert r1

        jsvalue cons_3 → a2
        jsvalue cons_4 → b2
        jsvalue lt? a2 b2 → r2        ; 3 < 4
        jsvalue assert r2

        jsvalue cons_3 → a3
        jsvalue cons_3 → b3
        jsvalue le? a3 b3 → r3        ; 3 <= 3
        jsvalue assert r3

        jsvalue cons_4 → a4
        jsvalue cons_3 → b4
        jsvalue gt? a4 b4 → r4        ; 4 > 3
        jsvalue assert r4

        jsvalue cons_3 → a5
        jsvalue cons_3 → b5
        jsvalue ge? a5 b5 → r5        ; 3 >= 3
        jsvalue assert r5
    )
)
